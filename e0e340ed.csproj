<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(SolutionDir)ToolingVersions.props" />
  <Import Project="$(SolutionDir)Directory.CppBuild.props" />

  <PropertyGroup Label="Core Properties">
    <!-- Root Properties -->
    <RootNamespace>WindowsAdvancedSettings</RootNamespace>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI/MSIX Specific -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableMsixProjectCapabilityAddedByProject>true</DisableMsixProjectCapabilityAddedByProject>
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup Label="Build Configuration">
    <!-- Build Ring defaults to Dev if not specified -->
    <BuildRing Condition="'$(BuildRing)' == ''">Dev</BuildRing>

    <!-- Output Type: Console for Debug, Windows for Release/Stable -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>

    <!-- Constants -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(BuildRing)' == 'Stable'">$(DefineConstants);STABLE_BUILD</DefineConstants>

    <!-- Assets Source Directory -->
    <AssetsSourceDir Condition="'$(BuildRing)' == 'Dev'">Assets\Dev</AssetsSourceDir>
    <AssetsSourceDir Condition="'$(BuildRing)' == 'Stable'">Assets\Production</AssetsSourceDir>

    <!-- Common Assets -->
    <ApplicationIcon>Assets\AdvancedSettings.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Label="Manifest Configuration">
    <!-- Build Ring-specific AppxManifest -->
    <AppxManifest Condition="'$(BuildRing)' == 'Dev'">Package-Dev.appxmanifest</AppxManifest>
    <AppxManifest Condition="'$(BuildRing)' == 'Stable'">Package.appxmanifest</AppxManifest>
  </PropertyGroup>

  <PropertyGroup Label="Publishing Configuration">
    <!-- Ready to Run -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunEmitSymbols>true</PublishReadyToRunEmitSymbols>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>

    <!-- Publish Profile -->
    <PublishProfileFullPath Condition="'$(BuildingInsideVisualStudio)' != 'true'">$(SolutionDir)\src\Common\PublishProfiles\win-$(Platform).pubxml</PublishProfileFullPath>
  </PropertyGroup>

  <PropertyGroup Label="Optimization Settings" Condition="'$(Configuration)' == 'Release' OR '$(BuildRing)' == 'Stable'">
    <!-- .NET 8 Performance Optimizations -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredPGO>true</TieredPGO>

    <!-- Trimming (optional - enable if app size is critical) -->
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
    <!-- <TrimMode>partial</TrimMode> -->

    <!-- Optimization Preference for .NET 8 -->
    <!-- <OptimizationPreference>Speed</OptimizationPreference> -->
  </PropertyGroup>

  <PropertyGroup Label="Build Quality">
    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Optional: Enable for stricter builds -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
    <!-- <WarningLevel>5</WarningLevel> -->
  </PropertyGroup>

  <PropertyGroup Label="Security Settings">
    <!-- Control Flow Guard and Spectre Mitigation handled in ItemDefinitionGroup -->
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <SpectreMitigation>Spectre</SpectreMitigation>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup Label="Package References">
    <!-- Windows SDK and CsWin32 -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.236">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.1" />

    <!-- Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />

    <!-- .NET Extensions -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Logging - Serilog -->
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="Assets - Logo and Icons">
    <!-- Include build ring-specific logo assets -->
    <Content Include="$(AssetsSourceDir)\**" Link="Assets\Logos\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />

    <!-- Main application icon -->
    <Content Include="Assets\AdvancedSettings.ico" CopyToOutputDirectory="PreserveNewest" />

    <!-- Application manifest -->
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Label="Configuration Files">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Label="Third Party Notices">
    <Content Include="$(SolutionDir)NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\NOTICE.txt</Link>
    </Content>
  </ItemGroup>

  <ItemGroup Label="Project References - Dev Build Only" Condition="'$(BuildRing)' == 'Dev'">
    <!-- Tester is only included in Dev builds -->
    <ProjectReference Include="..\..\test\AdvancedSettings.Tester\AdvancedSettings.Tester.csproj" />
  </ItemGroup>

  <ItemGroup Label="Project References - All Builds">
    <ProjectReference Include="..\Common\WindowsAdvancedSettings.Common.csproj" />
    <ProjectReference Include="..\FileExplorerGitIntegration\FileExplorerGitIntegration.csproj" />
    <ProjectReference Include="..\FileExplorerSourceControlIntegration\FileExplorerSourceControlIntegration.csproj" />
  </ItemGroup>
</Project>
