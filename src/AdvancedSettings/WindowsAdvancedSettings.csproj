<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(SolutionDir)ToolingVersions.props" />
  <Import Project="$(SolutionDir)Directory.CppBuild.props" />
  
  <PropertyGroup>
    <!-- Root Properties -->
    <RootNamespace>WindowsAdvancedSettings</RootNamespace>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI/Msix specific -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Set these properties directly to avoid the need for complex conditional ItemGroups later -->
    <DisableMsixProjectCapabilityAddedByProject>true</DisableMsixProjectCapabilityAddedByProject>
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>

    <!-- Build Configuration & Output -->
    <BuildRing Condition="'$(BuildRing)'==''">Dev</BuildRing>
    <PublishReadyToRunEmitSymbols>true</PublishReadyToRunEmitSymbols>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    
    <!-- Conditional Properties -->
    <!-- Debug builds produce a console app; otherwise a Windows app -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    
    <!-- Use a single definition for ApplicationIcon if the path is the same for both rings -->
    <ApplicationIcon>Assets\AdvancedSettings.ico</ApplicationIcon>
    
    <PublishProfileFullPath Condition="'$(BuildingInsideVisualStudio)' != 'True'">$(SolutionDir)\src\Common\PublishProfiles\win-$(Platform).pubxml</PublishProfileFullPath>
    
    <!-- Define constants for stable builds -->
    <DefineConstants Condition="'$(BuildRing)'=='Stable'">$(DefineConstants);STABLE_BUILD</DefineConstants>

    <!-- Define source directory for asset linking based on build ring -->
    <AssetsSourceDir Condition="'$(BuildRing)' == 'Dev'">Assets\Dev</AssetsSourceDir>
    <AssetsSourceDir Condition="'$(BuildRing)' == 'Stable'">Assets\Production</AssetsSourceDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <SpectreMitigation>Spectre</SpectreMitigation>
    </ClCompile>
  </ItemDefinitionGroup>
  
  <ItemGroup>
    <!-- Updated to latest stable versions -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.236">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 8.0.0 is latest for .NET 8.0 LTS -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <!-- These SDK package versions appear to be tied to specific insider/preview builds based on the build number -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
    <PackageReference Include="Serilog" Version="4.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- To build with the correct logo assets, only include the ones for the current build ring. -->
  <ItemGroup>
    <!-- Use the AssetsSourceDir property to include the correct files with a consistent link location -->
    <Content Include="$(AssetsSourceDir)\**" Link="Assets\Logos\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    
    <!-- Include the icon file explicitly here as well to ensure it's copied to output if needed -->
    <Content Include="Assets\AdvancedSettings.ico" CopyToOutputDirectory="Always" Condition="'$(BuildRing)' == 'Stable'" />

    <!-- Define the correct AppxManifest based on build ring -->
    <AppxManifest Include="Package-Dev.appxmanifest" Condition="'$(BuildRing)' == 'Dev'">
      <SubType>Designer</SubType>
    </AppxManifest>
    <AppxManifest Include="Package.appxmanifest" Condition="'$(BuildRing)' == 'Stable'">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Third party notice file -->
  <ItemGroup>
    <Content Include="$(SolutionDir)NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\NOTICE.txt</Link>
    </Content>
  </ItemGroup>

  <!-- Tester is only included in Dev builds -->
  <ItemGroup Condition="'$(BuildRing)' == 'Dev'">
    <ProjectReference Include="..\..\test\AdvancedSettings.Tester\AdvancedSettings.Tester.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Common\WindowsAdvancedSettings.Common.csproj" />
    <ProjectReference Include="..\FileExplorerGitIntegration\FileExplorerGitIntegration.csproj" />
    <ProjectReference Include="..\FileExplorerSourceControlIntegration\FileExplorerSourceControlIntegration.csproj" />
  </ItemGroup>
</Project>